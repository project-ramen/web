---
import '../styles/global.css';
import FoxSide from "./components/_svg/_fox_side.svg";
import Parasol from "./components/_svg/_parasol.svg";
import Lamp from "./components/_svg/_lamp.svg";
import pkg from "../../package.json";

interface Props {
  title?: string;
}
const { title = 'Ramen Blog' } = Astro.props;
const appVersion = pkg.version;
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isPost = pathname === '/post' || pathname.startsWith('/post/');
const isProject = pathname === '/projects' || pathname.startsWith('/projects/');
const isAbout = pathname === '/about' || pathname.startsWith('/about/');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Jua&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark') document.documentElement.classList.add('dark');
        else if (stored === 'light') document.documentElement.classList.remove('dark');
        else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen m-0 font-sans text-neutral-900 dark:text-neutral-100 bg-neutral-50 dark:bg-neutral-800 transition-colors overflow-x-hidden">
    <div class={`grid grid-rows-[auto_1fr_auto] ${isHome ? 'h-screen overflow-hidden' : 'min-h-screen'} items-center justify-items-center gap-0 sm:gap-8 sm:py-8 sm:px-8 md:pt-10 md:px-10 bg-web`} id="layout-container">
      <header id="site-header" class="sticky top-0 z-30 bg-web w-full max-w-[720px] min-w-0 px-4 py-4">
        <nav class="flex flex-wrap items-center justify-between gap-3 sm:gap-8 text-base sm:text-lg font-medium" aria-label="메인 메뉴">
          <div class="flex flex-wrap items-center gap-4 sm:gap-8 min-w-0" id="nav-links">
            <a href="/post" data-route="post" class={`nav-link text-neutral-900 dark:text-neutral-100 no-underline hover:underline underline-offset-2 ${isPost ? 'font-semibold underline' : ''}`}>Post</a>
            <a href="/" data-route="home" class={`nav-link text-neutral-900 dark:text-neutral-100 no-underline hover:underline underline-offset-2 ${isHome ? 'font-semibold underline' : ''}`}>Home</a>
            <a href="/projects" data-route="project" class={`nav-link text-neutral-900 dark:text-neutral-100 no-underline hover:underline underline-offset-2 ${isProject ? 'font-semibold underline' : ''}`}>Project</a>
            <a href="/about" data-route="about" class={`nav-link text-neutral-900 dark:text-neutral-100 no-underline hover:underline underline-offset-2 ${isAbout ? 'font-semibold underline' : ''}`}>About</a>
          </div>
          <button type="button" id="theme-toggle" class="p-2 rounded-lg text-neutral-900 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors" aria-label="다크/라이트 테마 전환">
            <span class="theme-icon-dark hidden dark:inline" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
            <span class="theme-icon-light dark:hidden inline" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
          </button>
        </nav>
      </header>
      <main class={`w-full max-w-[720px] min-w-0 justify-self-center box-border self-stretch min-h-0`}>
        {isPost && (
          <div class="fixed top-24 left-[calc(50%-360px)] translate-x-[-100%] hidden md:block [.dark_&]:hidden">
            <div class="peek-in parasol-sway">
              <Parasol width={200} class="translate-x-[20px]"/>
            </div>
          </div>
        )}
        {isPost && (
          <div class="fixed top-28 left-[calc(50%-360px)] translate-x-[-100%] hidden md:[.dark_&]:block">
            <div class="peek-in relative">
              <div class="lamp-glow"></div>
              <Lamp width={200} class="relative translate-x-[20px]"/>
            </div>
          </div>
        )}
        <div id="page-slot" class={`relative z-20 w-full min-h-full ${isHome ? '' : 'p-4 bg-neutral-50 dark:bg-neutral-800 rounded-none sm:rounded-2xl'}`}>
          <slot/>
        </div>
        <div class={`fixed top-1/2 left-[calc(50%-360px)] translate-x-[-100%] -translate-y-1/2 z-20 pointer-events-none ${isHome ? "hidden" : "hidden min-[850px]:block"}`}>
          <FoxSide width={100} class="translate-x-[20px]"/>
        </div>
        
      </main>
      <footer class="w-full max-w-[720px] min-w-0 px-4 py-4 flex flex-wrap items-center justify-between gap-3 text-sm text-neutral-500 dark:text-neutral-400 z-10 bg-neutral-50 dark:bg-neutral-800 sm:bg-transparent dark:sm:bg-transparent">
        <span class="flex items-center gap-2">
          <span>&copy; 2026 Ramen Blog</span>
          <span aria-hidden="true">·</span>
          <span>v{appVersion}</span>
        </span>
        <a href="mailto:dennis0324@naver.com" class="hover:text-neutral-900 dark:hover:text-neutral-100 hover:underline underline-offset-2" aria-label="이메일 보내기">dennis0324@naver.com</a>
      </footer>
    </div>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        document.dispatchEvent(new CustomEvent('theme-changed', { detail: { dark: isDark } }));
      });
      (function syncLayoutFromPathname() {
        var path = window.location.pathname || '/';
        var active = (path === '/' || path === '') ? 'home' : (path === '/post' || path.indexOf('/post/') === 0) ? 'post' : (path === '/projects' || path.indexOf('/projects/') === 0) ? 'project' : (path === '/about' || path.indexOf('/about/') === 0) ? 'about' : null;
        var nav = document.getElementById('nav-links');
        if (nav) {
          var links = nav.querySelectorAll('.nav-link');
          for (var i = 0; i < links.length; i++) {
            var link = links[i];
            var route = link.getAttribute('data-route');
            link.classList.remove('font-semibold', 'underline');
            if (route === active) link.classList.add('font-semibold', 'underline');
          }
        }
      })();
    </script>
  </body>
</html>

<style>
  .bg-web {
    background-color: #879e82;
  }
  .dark .bg-web {
    background-color: #586954;
  }

  .peek-in {
    transform-origin: bottom right;
    animation: peek-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes peek-in {
    0% {
      transform: translate(-14px, 18px) rotate(16deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
  }

  .parasol-sway {
    animation:
      peek-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      parasol-sway 3s ease-in-out 0.7s infinite;
  }

  @keyframes parasol-sway {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(5deg);
    }
    75% {
      transform: rotate(-5deg);
    }
  }

  .lamp-glow {
    position: absolute;
    top: 120px;
    left: 18px;
    width: 130px;
    height: 100px;
    transform: rotate(-15deg);
    transform-origin: top center;
    clip-path: polygon(23% 0%, 77% 0%, 100% 100%, 0% 100%);
    background: linear-gradient(180deg, rgba(235, 189, 65, 0.55) 0%, rgba(235, 189, 65, 0) 70%);
    pointer-events: none;
    opacity: 0;
    animation: lamp-on 0.5s ease-out 0.7s both;
  }

  @keyframes lamp-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
