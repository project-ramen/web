---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Ramen Blog' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Jua&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-grid">
      <header class="site-header">
        <nav class="header-nav" aria-label="메인 메뉴">
          <a href="/post">Post</a>
          <a href="/">Home</a>
          <a href="/project">Project</a>
          <a href="/about">About</a>
        </nav>
      </header>
      <main class="main">
        <slot />
      </main>
      <footer class="site-footer">
        <a class="footer-link" href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <span class="footer-icon" aria-hidden="true">⌘</span>
          <span class="footer-label">Github →</span>
        </a>
        <a class="footer-link" href="/post" aria-label="Logs">
          <span class="footer-icon" aria-hidden="true">◐</span>
          <span class="footer-label">Logs →</span>
        </a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --nav-height: 56px;
    --font-sans: 'Noto Sans KR', system-ui, sans-serif;
    --font-display: 'UhBee mysen', 'Jua', sans-serif;
    --font-uhbee: 'UhBee mysen', sans-serif;
    --color-fg: #1a1a1a;
    --color-muted: #505050;
    --color-border: #e5e5e5;
    --color-bg: #fafafa;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-padding-top: var(--nav-height);
  }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: var(--font-sans);
    color: var(--color-fg);
    background: var(--color-bg);
  }
  .page-grid {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
    align-items: center;
    justify-items: center;
    padding: 20px 2rem 5rem;
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .page-grid {
      padding: 2.5rem 2.5rem 5rem;
    }
  }
  .site-header {
    width: 100%;
    max-width: 720px;
  }
  .header-nav {
    display: flex;
    gap: 2rem;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .header-nav a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .header-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .main {
    width: 100%;
    max-width: 720px;
    padding: 0 1rem;
    justify-self: center;
  }
  .site-footer {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .footer-link:hover {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-link:hover .footer-label {
    max-width: 120px;
    opacity: 1;
  }
  .footer-icon {
    flex-shrink: 0;
    font-size: 1.25rem;
  }
  .footer-label {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transition: max-width 0.25s ease, opacity 0.2s ease;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 0.5rem 0;
    color: var(--color-fg);
  }
  .page-subtitle {
    color: var(--color-muted);
    font-size: 1rem;
    margin: 0 0 1.5rem 0;
  }
  .post-realtime-viewer { margin-top: 1rem; }
  .viewer-status { font-size: 0.875rem; color: var(--color-muted); margin-bottom: 0.5rem; }
  .viewer-status .connected { color: #0a6b0a; }
  .viewer-content-wrap { position: relative; }
  .viewer-content { line-height: 1.7; }
  article.viewer-content { display: flow-root; }
  .viewer-content .empty { color: #888; font-style: italic; }
  .viewer-content h1, .viewer-content h2, .viewer-content h3 { margin-top: 1.25em; margin-bottom: 0.5em; }
  .viewer-content pre { background: #f0f0f0; padding: 0.75rem; border-radius: 6px; overflow: auto; }
  .viewer-content code { font-family: ui-monospace, monospace; font-size: 0.9em; }
  .viewer-cursor-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: auto;
    padding: 0;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.7;
    box-sizing: border-box;
  }
  .viewer-cursor-mirror {
    word-break: break-word;
    visibility: hidden;
    height: min-content;
  }
  .viewer-remote-selection {
    position: absolute;
    pointer-events: none;
    opacity: 0.35;
    border-radius: 2px;
  }
  .viewer-remote-cursor {
    position: absolute;
    min-width: 2px;
    margin-top: 0;
    border-radius: 0.1em;
    animation: viewer-cursor-blink 1s step-end infinite;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.15);
    /* width, height: 인라인으로 측정값 적용 */
  }
  @keyframes viewer-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .comments-section { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .comment-form textarea { width: 100%; max-width: 480px; padding: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--color-border); border-radius: 6px; font-family: inherit; }
  .comment-form button { padding: 0.4rem 0.75rem; cursor: pointer; font-family: inherit; }
  .comment-list { list-style: none; padding: 0; margin: 1rem 0 0 0; }
  .comment-list li { padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); }
  .comment-meta { font-size: 0.875rem; color: var(--color-muted); }
  .post-list { list-style: none; padding: 0; }
  .post-list li { padding: 0.5rem 0; }
  .post-list a { text-decoration: none; color: var(--color-fg); }
  .post-list a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .post-list .meta { color: var(--color-muted); font-size: 0.875rem; }
  .deleted-section-notice { padding: 0.5rem; background: #fff8e6; border-left: 3px solid #e0a000; margin: 0.5rem 0; border-radius: 0 4px 4px 0; }
  .deleted-section-notice .link { background: none; border: none; color: #0066cc; cursor: pointer; text-decoration: underline; }
  .deleted-section-notice .revision-snippet { font-size: 0.875rem; white-space: pre-wrap; margin-top: 0.5rem; padding: 0.5rem; background: #f5f5f5; border-radius: 4px; }
</style>
