---
import Fox from './components/_svg/_fox.svg';
import Floor from './components/_svg/_floor.svg';
import Stand from './components/_svg/_stand.svg';
import Books from './components/_svg/_books.svg';
import Clock from './components/_svg/_clock.svg';

---
<div class="home-screen-wrapper">
    <div class="home-main">
      <div class="home-bottom">
        

        <Floor class="home-floor" stroke-width={16}/>

        <!-- <Floor class="home-floor" preserveAspectRatio={"none"}/> -->
        <div class="home-lamp-glow"></div>
        <div class="home-stand home-hoverable" data-tooltip="불 켜볼까?">
          <Stand width={180} />
        </div>
        <a class="home-fox home-hoverable" data-tooltip="안녕!" href="/about">
          <Fox width={250}/>
        </a>
        <a class="home-books home-hoverable left-[30%] md:left-[35%] lg:left-[40%]" data-tooltip="책 읽는 중" href="/projects">
          <Books width={100} />
        </a>
        <a class="home-clock home-hoverable" data-tooltip="시간" href="/post">
          <Clock width={100} />
        </a>

      </div>

    </div>

  </div>

<style>
  /* .home-screen-wrapper {
    height: 100%;
    overflow-y: hidden;
  } */
  .home-main {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }
  .home-bottom {
    position: relative;
    overflow: hidden;
    /* height: 300px; */
  }
  .home-fox {
    position: absolute;
    top: 250px;
    left: 50%;
    transform: translateX(-50%);
  }
  .home-floor {
    width: 9000px;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 70px;
  }
  .home-stand{
    cursor: pointer;
    position: absolute;
    top: 60px;
    left: 65%;
    transform: translateX(-50%);
  }
  .home-clock{
    position: absolute;
    top: 100px;
    left: 20%;
    transform: translateX(-50%);
  }
  .home-books{
    position: absolute;
    top: 400px;
    /* left: 35%; */
    transform: translateX(-50%);
  }
  .home-lamp-glow {
    position: absolute;
    top: 160px;
    left: 65%;
    transform: translateX(-50%);
    width: 260px;
    height: 200px;
    clip-path: polygon(32% 0%, 68% 0%, 100% 100%, 0% 100%);
    background: linear-gradient(180deg, rgba(235, 189, 65, 0.55) 0%, rgba(235, 189, 65, 0) 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  :global(.dark) .home-lamp-glow {
    opacity: 1;
  }
  .home-hoverable svg {
    display: block;
  }
  :global(#clock-hand-hour),
  :global(#clock-hand-minute) {
    transition: transform 0.2s ease-out;
  }
  .home-hoverable::before {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translate(-50%, 8px);
    background: #fff;
    color: #171717;
    padding: 3px 12px;
    border: 2px solid #171717;
    border-radius: 12px;
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 30;
    font-family: var(--font-family-display);
    font-size: 1.5rem;
  }
  .home-hoverable::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translate(-50%, 22px);
    border: 7px solid transparent;
    border-top-color: #171717;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 30;
  }
  .home-hoverable:hover::before {
    opacity: 1;
    transform: translate(-50%, -6px);
  }
  .home-hoverable:hover::after {
    opacity: 1;
    transform: translate(-50%, 8px);
  }
  .home-seasons-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .home-seasons {
    height: 20vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .home-season-label {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  :global(.dark) .home-season-label {
    color: var(--color-muted);
  }
  .home-title {
    font-family: var(--font-family-display);
    font-size: 3rem;
    margin: 0;
    font-weight: 400;
    color: var(--home-title-color, #171717);
  }
  :global(.dark) .home-title {
    color: var(--home-title-color, #fafafa);
  }
  @media (min-width: 640px) {
    .home-title {
      font-size: 4rem;
    }
  }
</style>

<script>
  document.querySelector('.home-stand')?.addEventListener('click', () => {
    document.getElementById('theme-toggle')?.click();
  });

  const eyes = document.getElementById('fox-eyes');

  if (eyes) {
    const RADIUS_X = 30;
    const RADIUS_Y = 15;
    let rect = eyes.getBoundingClientRect();

    eyes.style.transition = 'transform 0.08s ease-out';
    window.addEventListener('resize', () => {
      rect = eyes.getBoundingClientRect();
    });

    let raf: number | null = null;
    window.addEventListener('mousemove', (e) => {
      if (raf !== null) return;
      raf = requestAnimationFrame(() => {
        raf = null;
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy) || 1;
        const ux = dx / dist;
        const uy = dy / dist;
        eyes.style.transform = `translate(${ux * RADIUS_X}px, ${uy * RADIUS_Y}px)`;
      });
    });
  }

  const CLOCK_CENTER_X = 476.63;
  const CLOCK_CENTER_Y = 408.12;

  function updateClockHands() {
    const hourHand = document.getElementById('clock-hand-hour');
    const minuteHand = document.getElementById('clock-hand-minute');
    if (!hourHand || !minuteHand) return;

    const now = new Date();
    const hours = now.getHours() % 12;
    const minutes = now.getMinutes();
    const seconds = now.getSeconds();

    const hourAngle = (hours + minutes / 60) * 30;
    const minuteAngle = (minutes + seconds / 60) * 6;

    hourHand.setAttribute('transform', `rotate(${hourAngle} ${CLOCK_CENTER_X} ${CLOCK_CENTER_Y})`);
    minuteHand.setAttribute('transform', `rotate(${minuteAngle} ${CLOCK_CENTER_X} ${CLOCK_CENTER_Y})`);
  }

  updateClockHands();
  setInterval(updateClockHands, 1000);

  document.addEventListener('theme-changed', () => {
    const stand_switch = document.getElementById('stand-switch');
    if (!stand_switch) return;
    stand_switch.getAnimations().forEach((a) => a.cancel());
    stand_switch.animate(
      [
        { transform: 'translateY(0)' },
        { transform: 'translateY(60px)', offset: 0.4 },
        { transform: 'translateY(0)' },
      ],
      { duration: 400, easing: 'ease-in-out' },
    );
  });
</script>
