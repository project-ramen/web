---
import Layout from '../../layouts/Layout.astro';
import Seasons from './components/Seasons.astro';

const seasons = ["WINTER", "SPRING", "SUMMER", "FALL"] as const;
const seasonNames: Record<(typeof seasons)[number], string> = {
  WINTER: "겨울",
  SPRING: "봄",
  SUMMER: "여름",
  FALL: "가을",
};

function getSeason(date: Date) {
  const month = date.getMonth();
  return seasons[Math.floor((month + 1) / 3) % 4];
}

const season = getSeason(new Date());
const seasonLabel = seasonNames[season];
---
<Layout title="HOME | Ramen Blog">
  <main class="home-main">
    <div class="home-seasons-wrap">
      <Seasons class="home-seasons" />
    </div>
    <h1 class="home-title">개발 블로그</h1>
  </main>
</Layout>

<style>
  .home-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .home-seasons-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .home-seasons {
    height: 20vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .home-season-label {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .home-title {
    font-family: var(--font-display);
    font-size: 3rem;
    margin: 0;
    font-weight: 400;
  }
  @media (min-width: 640px) {
    .home-title {
      font-size: 4rem;
    }
  }
</style>
