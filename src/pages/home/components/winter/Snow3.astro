---
interface Props { color?: string; class?: string; }
const { color = "#505050", class: className } = Astro.props;
const transforms = ["translate(0 19)", "translate(70 51.5)", "translate(0 87)", "translate(129 73)", "translate(60 170.5)", "translate(184 32.5)", "translate(206 106)", "translate(134 203)", "translate(153 150)", "translate(-45 141)", "translate(85 -9)"];
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" width="265.828" height="226.657" viewBox="0 0 265.828 226.657">
  <g transform="translate(-97.5 -487.672)" style="stroke-linecap: round; stroke-width: 4; fill: none; stroke: none">
    {transforms.map((t) => (
      <g transform={t} stroke={color}>
        <line x2="10" transform="translate(144.5 503.5)" />
        <line x2="9" y2="9" transform="translate(145.5 499.5)" />
        <line x1="7" y2="9" transform="translate(145.5 499.5)" />
      </g>
    ))}
  </g>
</svg>
