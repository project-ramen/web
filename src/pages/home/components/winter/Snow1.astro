---
interface Props { color?: string; class?: string; }
const { color = "#505050", class: className } = Astro.props;
const transforms: (string | undefined)[] = [undefined, "translate(70 21)", "translate(-3 56)", "translate(139 47)", "translate(60 153.5)", "translate(161 -4.5)", "translate(189 87)", "translate(161 198)", "translate(144 125)", "translate(-48 108)", "translate(-8 193.5)"];
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" width="251.828" height="217.157" viewBox="0 0 251.828 217.157">
  <g transform="translate(-94.5 -492.172)" style="stroke-linecap: round; stroke-width: 4; fill: none; stroke: none">
    {transforms.map((t) => (
      <g transform={t} stroke={color}>
        <line x2="10" transform="translate(144.5 503.5)" />
        <line x2="9" y2="9" transform="translate(145.5 499.5)" />
        <line x1="7" y2="9" transform="translate(145.5 499.5)" />
      </g>
    ))}
  </g>
</svg>
