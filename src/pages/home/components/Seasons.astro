---
const seasons = [
  "WINTER", // Dec, Jan, Feb
  "SPRING", // Mar, Apr, May
  "SUMMER", // Jun, Jul, Aug
  "FALL",   // Sep, Oct, Nov
] as const;

function getSeason(date: Date) {
  const month = date.getMonth(); // 0-based (0 = January, 11 = December)
  return seasons[Math.floor((month + 1) / 3) % 4];
}

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const season = getSeason(new Date());

import Spring from "./spring/Spring.astro";
import Summer from "./summer/Summer.astro";
import Fall from "./fall/Fall.astro";
import Winter from "./winter/Winter.astro";
---

<div class={["flex", "justify-center", className].filter(Boolean).join(" ")}>
  {season === "SPRING" && <Spring />}
  {season === "SUMMER" && <Summer />}
  {season === "FALL" && <Fall />}
  {season === "WINTER" && <Winter />}
</div>
